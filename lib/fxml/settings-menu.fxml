<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml/1"
         spacing="10">

    <children>
        <VBox fx:id="menuPanel" alignment="CENTER" spacing="10"
              styleClass="hitech-panel">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>
            <children>
                <CheckBox fx:id="fullscreenCheckBox" text="Полный экран"
                          styleClass="settings-checkbox"/>
                <ChoiceBox fx:id="resolutionChoiceBox"
                           styleClass="settings-combobox"/>
                <Slider fx:id="volumeSlider" min="0" max="1"
                        showTickLabels="true" showTickMarks="true"
                        styleClass="settings-slider"
                        prefWidth="150" prefHeight="40"/>
                <!-- Save/Cancel buttons added dynamically -->
            </children>
        </VBox>
    </children>
</fx:root>
