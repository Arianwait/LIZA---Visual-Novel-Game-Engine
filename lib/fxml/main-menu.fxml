<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml/1"
         alignment="BOTTOM_LEFT">

    <children>
        <VBox fx:id="menuPanel" alignment="CENTER" spacing="10"
              styleClass="hitech-panel">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>
            <children>
                <Label fx:id="titleLabel" styleClass="hitech-panel-title"/>
                <!-- Buttons are added dynamically from Buttons.xml -->
            </children>
        </VBox>
    </children>
</fx:root>
