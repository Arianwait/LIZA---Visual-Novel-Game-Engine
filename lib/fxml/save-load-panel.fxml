<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<fx:root type="VBox" xmlns:fx="http://javafx.com/fxml/1"
         spacing="10">

    <children>
        <VBox fx:id="menuPanel" alignment="CENTER" spacing="10"
              styleClass="hitech-panel">
            <padding>
                <Insets top="50" right="50" bottom="50" left="50"/>
            </padding>
            <children>
                <Text fx:id="titleText" styleClass="hitech-panel-title"/>
                <VBox fx:id="buttonsBox" spacing="3" alignment="CENTER"/>
                <Button fx:id="returnButton" text="Вернутся"/>
            </children>
        </VBox>
    </children>
</fx:root>
