<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>kz.aws.game_main</groupId>
	<artifactId>kz.aws.game_main</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>

		<javafx.version>21.0.5</javafx.version>
		<main.class>kz.aws.game.dispatcher.GameDispatcher</main.class>

		<!-- Имя дистрибутива (без пробелов: имя exe и папки) и отображаемое название -->
		<app.name>ProjectElein</app.name>
		<app.title>Project Elein</app.title>
		<app.vendor>ArianwaitStudio</app.vendor>
		<!-- Данные игры (сюжет), которые кладутся в установщик рядом с exe -->
		<game.content>${project.basedir}/elein_test/lib</game.content>
	</properties>

	<dependencies>
		<!-- JavaFX Controls -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- JavaFX FXML -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- JSON -->
		<dependency>
			<groupId>com.github.cliftonlabs</groupId>
			<artifactId>json-simple</artifactId>
			<version>2.1.2</version>
			<scope>compile</scope>
		</dependency>

		<!-- JavaFX Media -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-media</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- Reflections: автопоиск классов по аннотациям в пакете (для ButtonActionRegistry) -->
		<dependency>
			<groupId>org.reflections</groupId>
			<artifactId>reflections</artifactId>
			<version>0.10.2</version>
		</dependency>

		<!-- Логирование: slf4j + logback (консоль и файл logs/game.log).
		     У игрока с .exe консоли нет — без файла диагностики не было вовсе. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.13</version>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.5.6</version>
		</dependency>

		<!-- JUnit 5: тесты модели движка (script-слой, merge визуала) -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Компилятор Java -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>

			<!-- Surefire 3.x: запуск JUnit 5 тестов (goal: test) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<!-- Тесты не должны писать в %APPDATA% реального пользователя -->
					<systemPropertyVariables>
						<liza.userdata>${project.build.directory}/test-userdata</liza.userdata>
						<liza.logs>${project.build.directory}/test-logs</liza.logs>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- Плагин JavaFX для запуска из Maven/Eclipse (goal: javafx:run) -->
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>${main.class}</mainClass>
					<!-- Убирает WARNING про native method в javafx.media -->
					<jvmArgs>
						<arg>--enable-native-access=javafx.media</arg>
					</jvmArgs>
				</configuration>
			</plugin>

			<!-- Делаем "толстый" jar со всеми зависимостями -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${main.class}</mainClass>
						</manifest>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Launch4j: из jar делаем .exe -->
			<plugin>
				<groupId>com.akathist.maven.plugins.launch4j</groupId>
				<artifactId>launch4j-maven-plugin</artifactId>
				<version>2.5.3</version> <!-- или 2.7.0, если хочешь самый
				последний -->
				<executions>
					<execution>
						<id>l4j-clui</id>
						<phase>package</phase>
						<goals>
							<goal>launch4j</goal>
						</goals>
						<configuration>
							<outfile>${project.build.directory}/ProjectElein-launch4j.exe</outfile>

							<jar>
								${project.build.directory}/${project.artifactId}-${project.version}-jar-with-dependencies.jar</jar>

							<headerType>gui</headerType>
							<errTitle>Project Elein Error</errTitle>

							<!-- minVersion обязан совпадать с maven.compiler.target:
							     код скомпилирован под 21, на JRE 17 запуск падает
							     с UnsupportedClassVersionError -->
							<jre>
								<path>jre</path>
								<minVersion>${maven.compiler.target}.0.0</minVersion>
								<bundledJre64Bit>true</bundledJre64Bit>
								<jdkPreference>preferJre</jdkPreference>
							</jre>
							<!-- при желании можно раскомментировать -->
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  Сборка нативного дистрибутива через jpackage (JDK 21).
		  В отличие от launch4j кладёт рядом правильный рантайм вместе с JavaFX,
		  поэтому у игрока не нужен установленный JRE и невозможен
		  UnsupportedClassVersionError.

		  Запуск:    mvn -Pjpackage clean package
		  Результат: target/dist/ProjectElein/ (.exe + собственный рантайм)
		  Папку lib/ с контентом нужно положить рядом с ProjectElein.exe
		  (портативная сборка для zip). Установщик собирает профиль installer.
		-->
		<profile>
			<id>jpackage</id>
			<build>
				<plugins>
					<!-- В payload попадает только толстый jar: раньше входной папкой
					     jpackage была вся target, и в дистрибутив уезжали classes/,
					     test-classes/ и прочий мусор сборки -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>prepare-jpackage-input</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.artifactId}-${project.version}-jar-with-dependencies.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>build-native-image</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>app-image</argument>
										<argument>--name</argument>
										<argument>${app.name}</argument>
										<argument>--description</argument>
										<argument>${app.title}</argument>
										<argument>--vendor</argument>
										<argument>${app.vendor}</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--icon</argument>
										<argument>${project.basedir}/dist-extras/ProjectElein.ico</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/jpackage-input</argument>
										<argument>--main-jar</argument>
										<argument>${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
										<argument>--main-class</argument>
										<argument>${main.class}</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/dist</argument>
										<argument>--app-content</argument>
										<argument>${project.basedir}/dist-extras/THIRD-PARTY-NOTICES.txt</argument>
										<argument>--java-options</argument>
										<argument>--enable-native-access=javafx.media</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!--
		  Установщик Windows: mvn -Pinstaller clean package -DskipTests
		  Результат: target/installer/ProjectElein-<version>.exe
		  Нужен WiX Toolset 3.x в PATH (jpackage собирает exe/msi через него).
		  Установка в профиль пользователя (без прав администратора), ярлыки
		  в меню «Пуск» и на рабочем столе, выбор папки. Данные игры (lib/)
		  и уведомления о лицензиях попадают внутрь.
		-->
		<profile>
			<id>installer</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>prepare-jpackage-input</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
									<resources>
										<resource>
											<directory>${project.build.directory}</directory>
											<includes>
												<include>${project.artifactId}-${project.version}-jar-with-dependencies.jar</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.2.0</version>
						<executions>
							<execution>
								<id>build-installer</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>exe</argument>
										<argument>--name</argument>
										<argument>${app.name}</argument>
										<argument>--description</argument>
										<argument>${app.title}</argument>
										<argument>--vendor</argument>
										<argument>${app.vendor}</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--icon</argument>
										<argument>${project.basedir}/dist-extras/ProjectElein.ico</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}/jpackage-input</argument>
										<argument>--main-jar</argument>
										<argument>${project.artifactId}-${project.version}-jar-with-dependencies.jar</argument>
										<argument>--main-class</argument>
										<argument>${main.class}</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/installer</argument>
										<argument>--app-content</argument>
										<argument>${game.content},${project.basedir}/dist-extras/THIRD-PARTY-NOTICES.txt</argument>
										<argument>--java-options</argument>
										<argument>--enable-native-access=javafx.media</argument>
										<argument>--win-per-user-install</argument>
										<argument>--win-dir-chooser</argument>
										<argument>--win-shortcut</argument>
										<argument>--win-menu</argument>
										<argument>--win-menu-group</argument>
										<argument>${app.title}</argument>
										<!-- Постоянный UUID: новые версии обновляют установленную, а не ставятся рядом -->
										<argument>--win-upgrade-uuid</argument>
										<argument>7c2b6e5a-9f41-4c3d-8a2e-5b1d0e7f3a91</argument>
										<!-- Свой main.wxs с Codepage=1251: имена файлов сюжета кириллические -->
										<argument>--resource-dir</argument>
										<argument>${project.basedir}/dist-extras/wix</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
